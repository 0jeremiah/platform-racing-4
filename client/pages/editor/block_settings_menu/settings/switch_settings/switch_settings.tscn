[node name="SwitchHelpInformation" type="RichTextLabel" parent="." unique_id=414396371]
layout_mode = 0
offset_top = 140.0
offset_right = 400.0
offset_bottom = 320.0
theme_override_font_sizes/normal_font_size = 16
text = "Activate Offset sets where the activate range will occur, with (0, 0) being where the block is.
Do note that negative values offsets the activate range up instead of down.

Activate Range determines how far the switch block will look for if \"Limit Activate Range\" is on. (0, 0) will have the switch block only check the exact place the location of the block, offsetted by Activate Offset is."

